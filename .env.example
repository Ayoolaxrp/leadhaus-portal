# ---- Live mode (Supabase) --------------------------------------------------
# Production always runs live. Locally, set AUTH_PROVIDER=supabase to test live mode.
# AUTH_PROVIDER=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_ and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=
# Where the portal lives, used in invite and sign-in emails.
NEXT_PUBLIC_SITE_URL=https://portal.leadhausstudios.com
# The marketing site, linked from the sign-in page.
NEXT_PUBLIC_MAIN_SITE_URL=https://leadhausstudios.com
# Optional: websites allowed to send leads to /api/leads (comma separated).
# Defaults to leadhausstudios.com, www.leadhausstudios.com and leadhaus-updated-site.vercel.app.
# LEAD_FORM_ORIGINS=

# ---- Local demo mode only ---------------------------------------------------
# Used by the demo account picker when AUTH_PROVIDER is not supabase.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
DEMO_PASSCODE=
